; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Dungeon Strikers"
run/main_scene="uid://csbxv6vcnwqc1"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://b7k3wfvekym8w"
config/icon="uid://b7k3wfvekym8w"

[audio]

buses/default_bus_layout="res://Assets/Audio/default_bus_layout.tres"

[autoload]

Global="*res://Autoloads/global.gd"
Players="*res://Autoloads/players.gd"
Net="*res://Autoloads/net.gd"
Sfx="*res://Autoloads/sfx.gd"
Vfx="*res://Autoloads/vfx.gd"
Cursor="*res://Autoloads/cursor.gd"

[debug]

gdscript/warnings/directory_rules={
"res://Assets/VFX": 0,
"res://addons": 0
}
gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1140
window/size/viewport_height=660
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode.editor=0

[file_customization]

folder_colors={
"res://Assets/": "teal",
"res://Autoloads/": "purple",
"res://Combat/": "red",
"res://Entities/": "orange",
"res://Game/": "green",
"res://Items/": "yellow",
"res://Network/": "purple",
"res://Perks/": "pink",
"res://Tools/": "gray",
"res://UI/": "blue"
}

[filesystem]

import/blender/enabled=false

[global_group]

Entity="Anything that can be interacted with in some way"
Particle=""
Interact=""
DEBUG=""
Weapon=""

[gui]

theme/custom="res://Assets/default_theme.tres"

